{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PlatformIO: Upload and Monitor",
            "type": "shell",
            "command": "source \"$HOME/.zshrc\" && platformio run --target upload --environment ${input:pioEnvironment} --upload-port ${input:pioPort} && platformio device monitor --environment ${input:pioEnvironment} --port ${input:pioPort}",
            "options": {
                "shell": {
                    "executable": "/bin/zsh",
                    "args": ["-l", "-c"]
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": false
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "pioEnvironment",
            "type": "promptString",
            "description": "PlatformIO environment",
            "default": "master_node_100"
        },
        {
            "id": "pioPort",
            "type": "promptString",
            "description": "Serial upload/monitor port",
            "default": "/dev/cu.usbserial-0001"
        }
    ]
}
